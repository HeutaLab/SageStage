{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Sage Stage's own data file under Documents, and nothing else.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Sage Stage" },
        { "path": "$DOCUMENT/Sage Stage/**" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-copy-file"
  ]
}
