{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sage Stage",
  "version": "0.1.0",
  "identifier": "org.sagestage.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8642",
    "beforeDevCommand": {
      "script": "sh serve-dev.sh",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "sh copy-dist.sh",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sage Stage",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https:; media-src 'self' blob: data: https:; frame-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
